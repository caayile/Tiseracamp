APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=TiseraBootcamp
DB_USERNAME=postgres
DB_PASSWORD=

# Agar data login/admin sama di semua laptop tim:
# pakai 1 database cloud bersama (Neon/Supabase).
# Pilih region SINGAPORE (ap-southeast-1) — jauh lebih cepat dari Indonesia.
# Pakai connection string "pooled" dari Neon kalau ada.
# Jangan pakai region US East (lambat dari Indonesia).

SESSION_DRIVER=file
CACHE_STORE=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Upload disk:
# - uploads = public/uploads (ikut GitHub, tanpa cloud) ← default
# - public  = storage/app/public (lokal, perlu storage:link)
# - s3      = Cloudflare R2 / AWS S3
UPLOAD_DISK=uploads
QUEUE_CONNECTION=sync

# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =========================
# MAIL (wajib SMTP agar email verifikasi masuk inbox)
# =========================
# Contoh Gmail:
# 1. Aktifkan 2FA di Google Account
# 2. Buat App Password: https://myaccount.google.com/apppasswords
# 3. Isi seperti di bawah (ganti email & app password)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=emailkamu@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM_ADDRESS="emailkamu@gmail.com"
MAIL_FROM_NAME="Tiga Serangkai"

# Pastikan APP_URL cocok dengan URL website (penting untuk link tombol verifikasi)
# APP_URL=http://127.0.0.1:8000

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Contoh Cloudflare R2 (gratis):
# UPLOAD_DISK=s3
# AWS_ACCESS_KEY_ID=xxxx
# AWS_SECRET_ACCESS_KEY=xxxx
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=tiga-serangkai
# AWS_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# AWS_URL=https://pub-xxxxx.r2.dev
# AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"
